maintainer: ["George Kaye <georgejkaye@gmail.com>"]
authors: ["George Kaye <georgejkaye@gmail.com>"]
license: "GPL-3.0-or-later"
tags: ["alcotest" "github actions" "ci" "testing"]
homepage: "https://github.com/georgejkaye/alcotest-github-action"
doc: "https://github.com/georgejkaye/alcotest-github-action/README.md"
bug-reports: "https://github.com/georgejkaye/alcotest-github-action/issues"
depends: [
  "dune" {>= "3.23"}
  "ocaml"
  "core"
  "core_unix"
  "fpath"
  "re"
  "ppx_deriving"
  "ppx_deriving_yojson"
  "ppx_string"
  "uuidm"
  "yojson"
